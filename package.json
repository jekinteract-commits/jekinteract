{
  "name": "jekinteract",
  "version": "1.0.23",
  "description": "JekInteract - tools interaksi TikTok Live (fase UI). Tanpa dependency, jalankan dengan npm start.",
  "main": "electron/main.js",
  "private": true,
  "author": {
    "name": "JekInteract",
    "email": "jekinteract@gmail.com"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "electron": "electron .",
    "electron:dev": "electron . --inspect",
    "build:win": "electron-builder --win --x64"
  },
  "engines": {
    "node": ">=16"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "msedge-tts": "^2.1.1",
    "selfsigned": "^5.5.0",
    "tiktok-live-connector": "^2.5.0",
    "ws": "^8.23.0"
  },
  "optionalDependencies": {
    "@nut-tree/nut-js": "^4.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.jekinteract.app",
    "productName": "JekInteract",
    "artifactName": "JekInteractUpdate-${version}.exe",
    "copyright": "Copyright © 2024",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "server.js",
      "public/**/*",
      "data/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!public/**/*.bak",
      "!**/*.bak",
      "!**/*.bak*",
      "!server.js.Sebelum*"
    ],
    "extraResources": [
      {
        "from": "resources/cloudflared/",
        "to": "cloudflared/",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nodeGypRebuild": false,
    "npmRebuild": true,
    "electronVersion": "31.0.0"
  }
}
